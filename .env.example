# Copy to `.env` and fill in. `.env` is git-ignored; this template is committed.

# ---- Database (Phase 0) ----
# Provision Neon Postgres from the Vercel Marketplace, then paste both URLs here.
#   DATABASE_URL  pooled host  (…-pooler.…neon.tech) — used by the app
#   DIRECT_URL    direct host  (no -pooler)          — used by `prisma migrate`
# For a plain local Postgres, set both to the same value.
DATABASE_URL="postgresql://user:password@host:5432/family_tree?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/family_tree?sslmode=require"

# ---- Auth.js + Google (Phase 1) ----
# AUTH_SECRET="run: npx auth secret"
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# ---- Vercel Blob (Phase 4 — person photos) ----
# Create a Blob store in the Vercel dashboard; it exposes this token.
BLOB_READ_WRITE_TOKEN=""
